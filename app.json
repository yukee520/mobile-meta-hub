{
  "expo": {
    "name": "Mobile Meta Hub",
    "slug": "mobile-meta-hub",
    "version": "1.0.0",
    "entryPoint": "./index.js",
    "orientation": "portrait",
    "android": {
      "package": "com.mobilemetahub.app"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableArchitectures": ["arm64-v8a", "armeabi-v7a", "x86_64"]
          }
        }
      ]
    ]
  }
}
